# Copy the values you need into the .env file at the project root
# (D:\HR Onboarding\.env) — the backend reads from there, not from this file.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hr_onboarding

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS: comma-separated origins the frontend is served from ---
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080

# --- Portal base URL (candidate login links are built from this) ---
PORTAL_BASE_URL=http://127.0.0.1:5500
# How long a one-click invite link stays valid (HR can always reissue).
INVITE_LINK_EXPIRY_DAYS=30

# --- Azure OpenAI (powers cross-form field mapping + candidate insights) ---
# Leave blank to run on the heuristic fallback with no AI calls.
# The VITE_-prefixed spellings are also accepted.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=
AI_MAPPING_ENABLED=true
AI_MAPPING_TIMEOUT=30
AI_MAPPING_MIN_CONFIDENCE=0.75
AI_INSIGHTS_ENABLED=true
AI_INSIGHTS_TIMEOUT=30

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# --- First-run seed HR login (used once by init_db.py) ---
SEED_HR_NAME=HR Admin
SEED_HR_EMAIL=hr@levelshift.com
SEED_HR_PASSWORD=ChangeMe@123
